{
  "name": "template-consumer-typescript",
  "version": "1.0.0",
  "private": true,
  "description": "Consumer test suite template using Playwright + TypeScript and @ots/playwright-core-ts framework",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ots/playwright-core-ts": "^0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.7.0",
    "dotenv": "^16.4.5",
    "typescript": "~5.6.3"
  }
}
