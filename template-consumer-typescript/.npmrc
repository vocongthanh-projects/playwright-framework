# GitLab Package Registry Configuration for @ots scoped packages.
# Replace <GITLAB_DOMAIN> (use HTTPS in production) and <PROJECT_ID> with your organization's settings.
@ots:registry=https://<GITLAB_DOMAIN>/api/v4/projects/<PROJECT_ID>/packages/npm/
//<GITLAB_DOMAIN>/api/v4/projects/<PROJECT_ID>/packages/npm/:_authToken=${GITLAB_TOKEN}
